{
  "name": "threejs-projects",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Three.js examples with a unified gallery and GitHub Pages deployment.",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "example:create": "node scripts/create-example.mjs",
    "example:validate": "node scripts/validate-examples.mjs",
    "gallery:generate": "node scripts/generate-gallery.mjs",
    "gallery:dev": "npm run dev --workspace @threejs/gallery",
    "gallery:build": "npm run build --workspace @threejs/gallery",
    "gallery:preview": "npm run preview --workspace @threejs/gallery",
    "site:build": "node scripts/build-all.mjs",
    "site:verify": "node scripts/verify-pages.mjs"
  },
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*"
  ]
}
